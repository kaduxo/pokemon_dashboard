# Get your free API key at https://dev.pokemontcg.io/
POKEMON_TCG_API_KEY=your_pokemon_tcg_api_key_here

# Anthropic API key for the AI card scanner (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: use an Anthropic-compatible proxy (e.g. Synthetic)
# ANTHROPIC_BASE_URL=https://api.synthetic.new/anthropic/v1
# SCANNER_MODEL=moonshotai/Kimi-K2.5

# Optional: LM Studio local inference for scanner
# LMSTUDIO_BASE_URL=http://localhost:1234
# LMSTUDIO_MODEL=your_local_model_name